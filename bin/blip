#!/bin/bash
# blip NAME - play a short freedesktop notification sound.
# Gates: BLIP=0 disables; optional BLIP_RATE_LIMIT; quiet hours 23:00-08:00 (err exempt, BLIP_QUIET_HOURS=0 disables);
#        optional per-name cooldown $BLIP_COOLDOWN_<NAME> seconds (default 0).
# Volume: $BLIP_VOLUME (default 0.35). Never blocks the caller.

SOUND_DIR="/usr/share/sounds/freedesktop/stereo"

blip_file() {
    case "$1" in
        done)       echo "message.oga" ;;
        ask)        echo "window-question.oga" ;;
        err)        echo "dialog-warning.oga" ;;
        tick)       echo "audio-volume-change.oga" ;;
        bell)       echo "bell.oga" ;;
        attn)       echo "window-attention.oga" ;;
        done-codex) echo "device-added.oga" ;;
        start)      echo "service-login.oga" ;;
        spawn)      echo "phone-outgoing-calling.oga" ;;
        subdone)    echo "complete.oga" ;;
        prompt)     echo "message-new-instant.oga" ;;
        tag)        echo "dialog-information.oga" ;;
        shot)       echo "camera-shutter.oga" ;;
        window)     echo "power-plug.oga" ;;
        lowbatt)    echo "suspend-error.oga" ;;
        download)   echo "trash-empty.oga" ;;
        lock)       echo "service-logout.oga" ;;
        unlock)     echo "device-removed.oga" ;;
        *)          return 1 ;;
    esac
}

ALL_NAMES=(done ask err tick bell attn done-codex start \
           spawn subdone prompt tag window lowbatt download lock unlock)

usage() {
    echo "usage: blip {${ALL_NAMES[*]}}" >&2
    echo "       blip --self-test" >&2
}

if [ "$1" = "--self-test" ]; then
    rc=0
    for n in "${ALL_NAMES[@]}"; do
        f="$SOUND_DIR/$(blip_file "$n")"
        if [ -r "$f" ]; then
            echo "ok    $n -> $f"
        else
            echo "MISS  $n -> $f"
            rc=1
        fi
    done
    exit $rc
fi

NAME="$1"
[ -n "$NAME" ] || { usage; exit 1; }
FILE_NAME="$(blip_file "$NAME")" || { usage; exit 1; }
SOUND="$SOUND_DIR/$FILE_NAME"

# Unknown/missing sound file is a hard error (surfaces typos in themes).
[ -r "$SOUND" ] || { echo "blip: missing sound file: $SOUND" >&2; exit 1; }

# Kill switch.
[ "$BLIP" = "0" ] && exit 0

# Quiet hours 23:00-08:00 (errors excepted) on by default; BLIP_QUIET_HOURS=0 disables.
HOUR=$(date +%-H)
if [ "${BLIP_QUIET_HOURS:-1}" = 1 ] && [ "$NAME" != "err" ] && { [ "$HOUR" -ge 23 ] || [ "$HOUR" -lt 8 ]; }; then
    exit 0
fi

# Per-name cooldown: BLIP_COOLDOWN_<NAME> seconds (default 0 = no extra limit).
# NAME is uppercased with '-' -> '_', e.g. BLIP_COOLDOWN_TAG=1, BLIP_COOLDOWN_DONE_CODEX=5.
COOLDOWN_VAR="BLIP_COOLDOWN_$(echo "$NAME" | tr 'a-z-' 'A-Z_')"
COOLDOWN="${!COOLDOWN_VAR:-0}"
NAME_STAMP="${XDG_RUNTIME_DIR:-/tmp}/blip.$NAME.last"
if [ "$COOLDOWN" -gt 0 ] 2>/dev/null && [ -f "$NAME_STAMP" ]; then
    NAME_LAST=$(stat -c %Y "$NAME_STAMP" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    [ $((NOW - NAME_LAST)) -lt "$COOLDOWN" ] && exit 0
fi

# Global rate limit: BLIP_RATE_LIMIT seconds between any two blips (default 0 = off;
# the user wants quick actions to make quick sounds).
STAMP="${XDG_RUNTIME_DIR:-/tmp}/blip.last"
RATE="${BLIP_RATE_LIMIT:-0}"
if [ "$RATE" -gt 0 ] && [ -f "$STAMP" ]; then
    LAST=$(stat -c %Y "$STAMP" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    [ $((NOW - LAST)) -lt "$RATE" ] && exit 0
fi
touch "$STAMP" 2>/dev/null
touch "$NAME_STAMP" 2>/dev/null

VOL="${BLIP_VOLUME:-0.35}"

if command -v pw-play >/dev/null 2>&1; then
    pw-play --volume "$VOL" "$SOUND" >/dev/null 2>&1 &
elif command -v paplay >/dev/null 2>&1; then
    # paplay volume is 0-65536 linear.
    PA_VOL=$(awk -v v="$VOL" 'BEGIN { printf "%d", v * 65536 }')
    paplay --volume "$PA_VOL" "$SOUND" >/dev/null 2>&1 &
else
    exit 0
fi

exit 0
