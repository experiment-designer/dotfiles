#!/usr/bin/env python3
"""htop under a vim key layer: h/j/k/l move, g/G ends, ^u/^d page, / and \\ type.

htop binds h=help, k=kill and l=lsof, so this pty relay rewrites navigation on
the way in.  /, \\, F3 and F4 hand the keyboard to htop's own input line until
Enter or Esc; Ctrl-v sends one key through as-is.
"""

import curses
import fcntl
import os
import pty
import select
import signal
import sys
import termios
import time
import tty

HTOP = "/usr/bin/htop"
ESCAPE_TIMEOUT = 0.035


def term_key(name: str, fallback: bytes) -> bytes:
    return curses.tigetstr(name) or fallback


class KeyTranslator:
    """Rewrite navigation keys; leave text entry and escape sequences literal."""

    def __init__(self) -> None:
        curses.setupterm()
        self.normal_keys = {
            ord("h"): term_key("kcub1", b"\x1b[D"),
            ord("j"): term_key("kcud1", b"\x1b[B"),
            ord("k"): term_key("kcuu1", b"\x1b[A"),
            ord("l"): term_key("kcuf1", b"\x1b[C"),
            ord("g"): term_key("khome", b"\x1b[H"),
            ord("G"): term_key("kend", b"\x1b[F"),
            0x04: term_key("knp", b"\x1b[6~"),  # Ctrl-d
            0x15: term_key("kpp", b"\x1b[5~"),  # Ctrl-u
        }
        # F3/F4 open htop's search and filter lines, exactly like / and \.
        self.text_keys = {b"\x1bOR", b"\x1bOS", b"\x1b[13~", b"\x1b[14~"}
        self.text_keys.update(k for k in map(curses.tigetstr, ("kf3", "kf4")) if k)
        self.text_mode = self.quote_next = self.paste_mode = False
        self.escape = bytearray()
        self.deadline = 0.0

    def _complete(self) -> bool:
        """True once the buffered escape is a whole sequence (Alt-x waits out)."""
        if len(self.escape) < 3:
            return False
        if self.escape[1] == ord("["):
            return 0x40 <= self.escape[-1] <= 0x7E
        return True

    def flush(self, now: float | None = None) -> bytes:
        """Release the buffered escape, whole or timed out as a bare Esc."""
        if not self.escape or (now is not None and now < self.deadline):
            return b""
        value, self.deadline = bytes(self.escape), 0.0
        self.escape.clear()
        if value == b"\x1b":
            self.text_mode = False
        elif value in self.text_keys:
            self.text_mode = True
        elif value == b"\x1b[200~":
            self.paste_mode = True
        return value

    def feed(self, data: bytes, now: float | None = None) -> bytes:
        now = time.monotonic() if now is None else now
        out = bytearray()
        for byte in data:
            if self.paste_mode:
                out.append(byte)
                self.paste_mode = not out.endswith(b"\x1b[201~")
            elif self.escape:
                self.escape.append(byte)
                if self._complete():
                    out.extend(self.flush())
            elif byte == 0x1B:
                self.escape.append(byte)
                self.deadline = now + ESCAPE_TIMEOUT
            elif self.quote_next:
                out.append(byte)
                self.quote_next = False
            elif self.text_mode:
                out.append(byte)
                self.text_mode = byte not in (0x0A, 0x0D)
            elif byte == 0x16:  # Ctrl-v: the next key reaches htop unchanged
                self.quote_next = True
            elif byte in (ord("/"), ord("\\")):
                out.append(byte)
                self.text_mode = True
            else:
                out.extend(self.normal_keys.get(byte, bytes((byte,))))
        return bytes(out)


def sync_size(master_fd: int, source_fd: int) -> None:
    size = fcntl.ioctl(source_fd, termios.TIOCGWINSZ, b"\0" * 8)
    fcntl.ioctl(master_fd, termios.TIOCSWINSZ, size)


def self_test() -> None:
    keys = KeyTranslator()
    nav = keys.normal_keys
    assert keys.feed(b"hjklgG\x04\x15") == b"".join(nav[b] for b in b"hjklgG\x04\x15")
    assert keys.feed(b"/hello jk\r") == b"/hello jk\r" and not keys.text_mode
    assert keys.feed(b"\\kernel hl\x1b", now=0.0) == b"\\kernel hl"
    assert keys.flush(now=1.0) == b"\x1b" and not keys.text_mode
    assert keys.feed(b"\x16l") == b"l"
    assert keys.feed(b"\x1b[B\x1b[5~", now=0.0) == b"\x1b[B\x1b[5~"
    assert keys.feed(b"\x1bOR", now=0.0) == b"\x1bOR" and keys.text_mode
    assert keys.feed(b"jk\n") == b"jk\n" and not keys.text_mode
    paste = b"\x1b[200~jk\x1b[201~"
    assert keys.feed(paste, now=0.0) == paste and not keys.paste_mode
    print("htop wrapper key translation: ok")


def run(arguments: list[str]) -> int:
    stdin_fd, stdout_fd = sys.stdin.fileno(), sys.stdout.fileno()
    saved = termios.tcgetattr(stdin_fd)
    keys = KeyTranslator()
    child_pid, master_fd = pty.fork()
    if child_pid == 0:
        os.execv(HTOP, ["htop", *arguments])
    resized = False

    def on_winch(_signum: int, _frame: object) -> None:
        nonlocal resized
        resized = True

    try:
        sync_size(master_fd, stdin_fd)
        tty.setraw(stdin_fd)
        sources = [stdin_fd, master_fd]
        signal.signal(signal.SIGWINCH, on_winch)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
        alive = True
        while alive:
            now = time.monotonic()
            timed_out = keys.flush(now)
            if timed_out:
                os.write(master_fd, timed_out)
            if resized:
                resized = False
                sync_size(master_fd, stdin_fd)
                os.kill(child_pid, signal.SIGWINCH)

            wait = keys.deadline - now if keys.escape else 0.05
            for source in select.select(sources, (), (), max(0.0, min(0.05, wait)))[0]:
                if source == stdin_fd:
                    data = os.read(stdin_fd, 4096)
                    if data:
                        os.write(master_fd, keys.feed(data))
                    else:
                        sources.remove(stdin_fd)
                    continue
                try:  # after htop exits, reading the master raises EIO
                    data = os.read(master_fd, 65536)
                except OSError:
                    data = b""
                alive = bool(data)
                if data:
                    os.write(stdout_fd, data)
    finally:
        termios.tcsetattr(stdin_fd, termios.TCSAFLUSH, saved)
        os.write(stdout_fd, b"\x1b[0m\x1b[?25h")
        os.close(master_fd)  # hangs up the pty, so htop exits if it has not
    return os.waitstatus_to_exitcode(os.waitpid(child_pid, 0)[1])


def main() -> int:
    if sys.argv[1:] == ["--wrapper-self-test"]:
        self_test()
        return 0
    if not os.access(HTOP, os.X_OK):
        sys.exit(f"htop wrapper: cannot execute {HTOP}")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        os.execv(HTOP, ["htop", *sys.argv[1:]])
    return run(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
