#!/usr/bin/env bash
set -euo pipefail
source /home/guy/dotfiles/dotfiles-manifest.sh
args=()
while (($#)); do
    case "$1" in
        -P|--profile|-profile) shift; (($#)) && shift ;;
        --profile=*|-profile=*|--no-remote|-no-remote|--new-instance|-new-instance|--ProfileManager|-ProfileManager) shift ;;
        *) args+=("$1"); shift ;;
    esac
done
if profile=$(find_firefox_developer_profile); then
    args=(--profile "$profile" "${args[@]}")
fi
exec /usr/lib/firefox-developer-edition/firefox "${args[@]}"
