URxvt*scrollBar: false
URxvt.font: xft:InputMono Nerd Font:size=11
URxvt.boldFont: xft:InputMono Nerd Font:style=Bold:size=11
URxvt.lineSpace: 0
URxvt*internalBorder: 8
URxvt.letterSpace: 0
URxvt.perl-ext-common: default,matcher
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.button: 1
URxvt.cursorBlink: false
URxvt.cursorColor: #ffb340
URxvt.cursorColor2: #16181d
URxvt.highlightColor: #2c313a
Xft.dpi: 96
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb

! -----------------------------------------------------------------------------
! Phosphor palette — see ~/dotfiles/palette.md
! Near-black canvas, near-white text, amber for state.
! -----------------------------------------------------------------------------
*background: #16181d
*foreground: #e6e9ed
*cursorColor: #ffb340

! ANSI normal
*color0:  #23272e
*color1:  #ff4d6d
*color2:  #98c379
*color3:  #ffb340
*color4:  #5b9dff
*color5:  #d67cff
*color6:  #5ed3f3
*color7:  #dfe3e8

! ANSI bright
*color8:  #7b838f
*color9:  #ff7a90
*color10: #b3d98f
*color11: #ffc966
*color12: #82b6ff
*color13: #e3a0ff
*color14: #8ee3fa
*color15: #f4f6f8
