URxvt*scrollBar: false
URxvt.font: xft:InputMono Nerd Font:size=11
URxvt.boldFont: xft:InputMono Nerd Font:style=Bold:size=11
URxvt.lineSpace: 0
URxvt*internalBorder: 8
URxvt.letterSpace: 0
URxvt.perl-ext-common: default,matcher
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.button: 1
URxvt.cursorBlink: false
URxvt.cursorColor: #c3f542
URxvt.cursorColor2: #07080a
URxvt.highlightColor: #1c2027
Xft.dpi: 96
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb

! -----------------------------------------------------------------------------
! Phosphor palette — see ~/dotfiles/palette.md
! Near-black canvas, near-white text, lime for state.
! -----------------------------------------------------------------------------
*background: #07080a
*foreground: #e6e9ed
*cursorColor: #c3f542

! ANSI normal
*color0:  #14171c
*color1:  #ff4d6d
*color2:  #c3f542
*color3:  #ffb340
*color4:  #5b9dff
*color5:  #d67cff
*color6:  #5ed3f3
*color7:  #c9ced6

! ANSI bright
*color8:  #5b626c
*color9:  #ff7a90
*color10: #d9ff70
*color11: #ffc966
*color12: #82b6ff
*color13: #e3a0ff
*color14: #8ee3fa
*color15: #f4f6f8
